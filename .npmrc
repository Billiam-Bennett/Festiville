# Don't auto-install packages that are only "peer" dependencies of what we use. The colyseus package
# lists every server transport as a peer, including one (uWebSockets.js) that npm can only fetch
# with git; we use the plain WebSocket transport. The peers the server does load are listed in
# package.json, so installs work on machines without git (the Docker image, Windows).
legacy-peer-deps=true
